{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "outDir": "dist-electron",
    "sourceMap": true,
    "strict": true
  },
  "include": ["electron/**/*.ts", "shared/**/*.ts", "vite.config.ts"]
}
