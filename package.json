{
  "name": "electron-toolbox-learning",
  "version": "0.1.2",
  "private": true,
  "description": "Electron Desktop Toolbox - learning project",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:vite": "cross-env ELECTRON_SKIP=1 vite",
    "dev:electron": "tsc -p tsconfig.node.json && cross-env NODE_ENV=development electron . --no-sandbox --disable-gpu-sandbox",
    "build": "tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "build:electron": "tsc -p tsconfig.node.json && vite build && electron-builder",
    "build:win": "tsc -p tsconfig.node.json && vite build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "build": {
    "appId": "com.electron.toolbox",
    "productName": "ElectronToolbox",
    "directories": {
      "output": "../release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "http://127.0.0.1:8080/updates"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}